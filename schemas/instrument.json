{
  "name": "Instrument",
  "plural": "instruments",
  "label": "Instruments",
  "description": "A tradable global security (stock or ETF) listed on an exchange identified by its ISO 10383 MIC.",
  "fields": [
    { "name": "id", "type": "long", "primaryKey": true, "generated": true, "label": "ID" },
    { "name": "symbol", "type": "string", "required": true, "maxLength": 16, "searchable": true, "filterable": true },
    { "name": "name", "type": "string", "required": true, "maxLength": 120, "searchable": true },
    { "name": "isin", "type": "string", "maxLength": 12, "searchable": true, "label": "ISIN" },
    { "name": "instrumentType", "type": "enum", "values": ["STOCK", "ETF"], "required": true, "filterable": true },
    { "name": "exchangeMic", "type": "string", "maxLength": 8, "label": "Exchange (MIC)", "filterable": true },
    { "name": "country", "type": "string", "maxLength": 2, "filterable": true },
    { "name": "currency", "type": "string", "maxLength": 3, "filterable": true },
    { "name": "sector", "type": "string", "maxLength": 60, "filterable": true },
    { "name": "lastPrice", "type": "decimal", "precision": 19, "scale": 4 },
    { "name": "marketCap", "type": "long", "label": "Market Cap / AUM" },
    { "name": "expenseRatio", "type": "decimal", "precision": 6, "scale": 4, "label": "Expense Ratio (%)", "description": "Annual fee, ETFs only" },
    { "name": "listedDate", "type": "date" },
    { "name": "active", "type": "boolean", "filterable": true }
  ]
}
